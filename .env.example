APP_NAME=AION
APP_VERSION=2.0.0
ENVIRONMENT=development
ALLOW_UNAUTHENTICATED_DEV=true

# Production: use separate, long random values. Do not reuse provider keys.
AION_API_KEYS=
AION_ADMIN_KEYS=
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_CHATS=4
MAX_CONTEXT_MESSAGES=40
MAX_MESSAGE_CHARS=100000
MAX_REQUEST_BYTES=2000000
MAX_COMPLETION_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=60
AION_DATA_DIR=./data

OPENROUTER_API_KEY=
OPENAI_API_KEY=
MOONSHOT_API_KEY=
NVIDIA_API_KEY=
BITDEER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PRIMARY_MODEL=moonshotai/kimi-k3
FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b,deepseek/deepseek-chat

# Web search
BRAVE_API_KEY=

# GitHub App (recommended). GITHUB_TOKEN is a server-side fallback only.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOSITORIES=ABBYCRM/aion-frontend,ABBYCRM/aion-backend-v2
GITHUB_WRITE_ENABLED=false
